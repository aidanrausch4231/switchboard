{
  "name": "@switchboard/ui",
  "description": "Switchboard browser page and Remote assembly",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh-upstream/vendor/cordis",
    "@deepseek-ai/dsh-api-gateway": "link:../../../dsh-upstream/packages/api/gateway",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../dsh-upstream/packages/api/session-controller",
    "@deepseek-ai/dsh-brand": "link:../../../dsh-upstream/packages/util/brand",
    "@deepseek-ai/dsh-client-locale": "link:../../../dsh-upstream/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../../../dsh-upstream/packages/client/store",
    "@deepseek-ai/dsh-client-test-runtime": "link:../../../dsh-upstream/packages/test-support/client-runtime",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../../dsh-upstream/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../dsh-upstream/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../../dsh-upstream/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../../dsh-upstream/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../dsh-upstream/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../../dsh-upstream/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../../../dsh-upstream/packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../dsh-upstream/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-workspace": "link:../../../dsh-upstream/packages/client/ui-workspace",
    "@deepseek-ai/dsh-llm": "link:../../../dsh-upstream/packages/llm/llm",
    "@deepseek-ai/dsh-remote-mock": "link:../../../dsh-upstream/packages/test-support/remote-mock",
    "@deepseek-ai/dsh-session": "link:../../../dsh-upstream/packages/core/session",
    "@switchboard/core": "workspace:*",
    "@switchboard/council": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "link:../../../dsh-upstream/packages/typert/protocol",
    "@deepseek-ai/dsh-util-crypto": "link:../../../dsh-upstream/packages/util/crypto",
    "@deepseek-ai/dsh-util-values": "link:../../../dsh-upstream/packages/util/values",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@xyflow/react": "^12.12.0",
    "mdast-util-from-markdown": "^2.0.3",
    "playwright": "^1.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
