{
  "name": "@switchboard/bundle",
  "description": "Switchboard plugins with privacy defaults",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../dsh-upstream/vendor/cordis",
    "js-yaml": "^4.1.0"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-subagent-claude-code": "link:../../../dsh-upstream/packages/subagent/subagent-claude-code",
    "@switchboard/council": "workspace:*",
    "@switchboard/core": "workspace:*",
    "@switchboard/ui": "workspace:*"
  }
}
